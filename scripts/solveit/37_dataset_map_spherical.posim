# 37. Convert coordinates: Cartesian -> spherical, and 2-D polar.
# A planar two-body orbit is recorded, then MAPPED. In spherical
# coordinates a z = 0 orbit must sit on the equator: the polar-angle
# column of the mapped dataset is pi/2 = 1.5707963267948966 at EVERY
# frame - MIN and MAX agree to the bit. The same trajectory maps
# through the 2-D polar system (allowed because the trajectory is
# planar; the |z| <= 1e-9 requirement is checked), and SQL reads the
# planet's radial range about the fixed centre of mass straight out
# of the polar dataset. Value-level round trips close the loop.
set system.g_constant = 1
new sphere as sun { mass = 3, radius = 0.1, position = [-0.25, 0, 0], velocity = [0, -0.63245553203367588, 0] }
new sphere as planet { mass = 1, radius = 0.05, position = [0.75, 0, 0], velocity = [0, 1.8973665961010276, 0] }
method adams
dataset create solveit37_orbit
run 12.418264743622237 steps 100
dataset close
dataset map solveit37_orbit to spherical as solveit37_sph
dataset open solveit37_sph
sql "SELECT MIN(y) AS theta_min, MAX(y) AS theta_max FROM states"
sql "SELECT COUNT(*) AS null_velocity_rows FROM states WHERE vx IS NULL"
dataset close
dataset map solveit37_orbit to polar2 as solveit37_pol
dataset open solveit37_pol
sql "SELECT MIN(x) AS r_min, MAX(x) AS r_max FROM states WHERE body = (SELECT body FROM bodies WHERE name = 'planet')"
dataset close
dataset play solveit37_sph
# the value level: the maps and their inverses, on the spot
cart_to_spherical([0, 0, 2])
spherical_to_cart(cart_to_spherical([1.3, 0.7, 2.1]))
cart2_to_polar([3, 4])
polar_to_cart2(cart2_to_polar([3, 4]))
